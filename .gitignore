# dependencies
node_modules/
package-lock.json

# environment & secrets
.env
*.env
!.env.example

# private signing keys. the private half of a certificate key lives in .env and
# nowhere else, but a stray .pem export would be just as fatal, so refuse them all.
*.private.pem
*.private.key
*.pkcs8

# per-developer dev signing key, from `npm run keygen:dev`. local to one machine.
# backend/keys/cert-signing.public.pem is the TEAM key and stays tracked — the
# architecture distributes it on purpose so every machine verifies the same issuer.
backend/keys/*.dev.public.pem

# sqlite db
*.db
*.db-journal
*.sqlite
data/
backend/data/

# build outputs
dist/
build/

# Capacitor Android platform — generated locally, never committed.
# Rebuild from a clean clone:
#   npx cap add android && npx cap sync android
#
# Ignore the whole directory and keep only the README. Naming the generated paths
# one by one meant `cap add android` also left build.gradle, settings.gradle,
# variables.gradle, gradle.properties, gradlew, gradlew.bat and gradle/ untracked
# and waiting to be committed by accident.
/android/*
!/android/README.md

# logs
*.log
logs/

# ide & os
.DS_Store
Thumbs.db
.vscode/
.idea/
