# SafeAR Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
DB_PATH=./data/safear.db

# Certificate signing — Ed25519.
# Run `npm run keygen` in backend/, paste the printed private key here.
# The private key NEVER goes in git. The public key is committed and is not a secret.
CERT_PRIVATE_KEY=change_me_run_npm_run_keygen_and_paste_the_private_key
CERT_PUBLIC_KEY_PATH=./keys/cert-signing.public.pem
CERT_ISSUER=SafeAR-Authority-Jharkhand

# Dashboard Admin Key
ADMIN_API_KEY=change_me_admin_api_key

# CORS — comma separated. capacitor://localhost and http://localhost are the
# Android WebView origins; drop them and the APK cannot call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,https://localhost,capacitor://localhost

# Max request body for a sync batch
BODY_LIMIT=1mb
