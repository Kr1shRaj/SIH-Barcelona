# SafeAR Environment Configuration Template
#
# Copy this file to .env at the repository root and fill in the marked values:
#
#   PowerShell   Copy-Item .env.example .env
#   bash / zsh   cp .env.example .env
#
# .env is gitignored and must NEVER be committed. Everything the backend treats as
# a secret lives there and nowhere else.
#
# Every variable marked REQUIRED must be set or the backend refuses to boot and
# names the ones you missed. Full walkthrough: README.md → "Backend Local Setup".
#
# Legend
#   REQUIRED   backend will not start without it
#   SECRET     never commit, never paste in chat, never screenshot
#   GENERATED  produced by a command, not chosen by you
#   CHOSEN     you pick the value


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on. Optional — defaults to 3000.
# The frontend assumes 3000 during local development, so changing it means
# passing ?api=http://localhost:<port> to the frontend as well.
PORT=3000

# development | production. Optional — defaults to development.
# In production the placeholder values below are a hard boot failure rather than
# a warning, which is deliberate. Leave this as development on your laptop.
NODE_ENV=development

# pino level: trace|debug|info|warn|error|fatal|silent. Optional, defaults to info.
LOG_LEVEL=info


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# REQUIRED. SQLite file for this machine. A relative path resolves against
# backend/, so the default lands at backend/data/safear.db.
#
# GENERATED, not committed: the file is created on first boot, and
# `npm run seed` fills it with the demo workers, modules and checkpoint manifest.
# Every *.db file is gitignored — your database is yours.
#
# After pulling a branch with a newer schema the backend will refuse to start and
# say which version it wanted. Delete the file and re-seed:
#
#   PowerShell   Remove-Item backend/data/safear.db
#   bash / zsh   rm backend/data/safear.db
#   then         npm run seed
DB_PATH=./data/safear.db


# ---------------------------------------------------------------------------
# Certificate signing — Ed25519
# ---------------------------------------------------------------------------
# Certificates are signed with an Ed25519 private key and verified against the
# matching public key. The two halves are handled completely differently.

# REQUIRED · SECRET · GENERATED.
# Base64 PKCS8 Ed25519 private key. This is the only thing that can mint a
# SafeAR certificate. It lives in .env and in no other file, ever.
#
# To run the backend on your own machine, generate a local dev key:
#
#   npm run keygen:dev
#
# That prints a CERT_PRIVATE_KEY= line — paste it here, replacing the placeholder
# below — and also prints the CERT_PUBLIC_KEY_PATH to set a few lines down.
# It writes only a gitignored dev public key and never touches the team key.
#
# Do NOT run `npm run keygen` (no :dev) for setup. That rotates the shared TEAM
# key and orphans every certificate already issued. See README.
CERT_PRIVATE_KEY=change_me_run_npm_run_keygen_and_paste_the_private_key

# REQUIRED · NOT SECRET.
# Path to the public key certificates are verified against. Relative paths
# resolve against backend/.
#
#   ./keys/cert-signing.public.pem       the shared TEAM key (committed).
#                                        Use this only if a teammate has given
#                                        you the matching CERT_PRIVATE_KEY.
#   ./keys/cert-signing.dev.public.pem   your own key from `npm run keygen:dev`.
#                                        Use this when working alone.
#
# The private key and this file must be halves of the same pair. They are
# checked against each other at boot and a mismatch is a loud, immediate failure
# rather than a certificate nobody can verify later.
CERT_PUBLIC_KEY_PATH=./keys/cert-signing.public.pem

# REQUIRED · NOT SECRET · CHOSEN (but keep the default).
# Issuer name stamped into every certificate. It is part of the signed payload,
# so changing it makes previously issued certificates read as a different issuer.
# Leave it alone unless you are deliberately standing up a separate authority.
CERT_ISSUER=SafeAR-Authority-Jharkhand


# ---------------------------------------------------------------------------
# Admin API
# ---------------------------------------------------------------------------

# REQUIRED · SECRET · CHOSEN.
# Guards the compliance dashboard endpoints. Compared in constant time.
#
# Pick your OWN value for local development — there is no shared team admin key
# and one must never be committed. Any long random string will do:
#
#   PowerShell   [guid]::NewGuid().ToString()
#   bash / zsh   openssl rand -hex 24
#   any shell    node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# Leaving the placeholder below logs a warning in development and is a hard boot
# failure in production. Both behaviours are intentional.
ADMIN_API_KEY=change_me_admin_api_key


# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Optional — comma separated, matched exactly. There is no wildcard and no
# pattern matching: an origin is either on this list or it is refused.
#
# Setting this in .env REPLACES the whole built-in list, it does not add to it.
# So always keep the entries below and append to the end of the line — deleting
# them silently breaks the dev servers and the APK.
#
# capacitor://localhost and http://localhost are the Android WebView origins.
# Drop them and the APK cannot call the API at all.
#
# To demo on a phone browser over Wi-Fi, append the address the PHONE types into
# its URL bar, which is your machine's LAN address and the frontend port:
#
#   ALLOWED_ORIGINS=http://localhost:5173,...,capacitor://localhost,http://192.168.1.50:5173
#
# 192.168.1.50 is an RFC1918 example. Use your own machine's address, and never
# commit it — it belongs in your local .env, which git already ignores.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,https://localhost,capacitor://localhost

# Optional — max request body for a sync batch. Defaults to 1mb.
# 50 attempts x 3 checkpoints of observation data tops out near 600kb.
BODY_LIMIT=1mb
